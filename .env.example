# Root environment reference for VendorBridge (see server/.env.example and client/.env.example)

# Backend Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://vendorbridge:vendorbridge@localhost:5432/vendorbridge?schema=public
JWT_ACCESS_SECRET=super-secret-vendorbridge-access-key-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
ADMIN_INVITE_CODE=ADMIN_SECRET_INVITE_2026

# Frontend Client
VITE_API_BASE_URL=http://localhost:4000/api/v1
