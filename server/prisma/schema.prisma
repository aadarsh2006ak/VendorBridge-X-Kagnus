datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  MANAGER
  VENDOR
}

enum VendorStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  QUOTATION_SELECTED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoStatus {
  ISSUED
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

model Counter {
  key   String @id
  value Int
}

model User {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  passwordHash   String
  phone          String
  country        String
  role           Role
  additionalInfo String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  vendors            Vendor[]
  auditLogs          AuditLog[]
  vendorMembers      VendorMember[]
  createdRfqs        Rfq[]                @relation("RfqCreator")
  selectedRfqs       Rfq[]                @relation("RfqSelector")
  approvalsRequested ApprovalRequest[]    @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[]    @relation("ApprovalDecider")
  purchaseOrders     PurchaseOrder[]      @relation("PoCreator")
  invoices           Invoice[]            @relation("InvoiceCreator")
  notifications      Notification[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vendor {
  id           String       @id @default(uuid())
  name         String
  category     String
  gstNumber    String
  contactName  String
  contactEmail String
  contactPhone String
  address      String?
  notes        String?
  status       VendorStatus @default(PENDING)
  rating       Float?
  deletedAt    DateTime?    // Soft delete timestamp
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    User         @relation(fields: [createdById], references: [id])

  members        VendorMember[]
  rfqs           RfqVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([status])
  @@index([category])
  @@index([name])
  @@index([deletedAt])
}

model VendorMember {
  id        String   @id @default(uuid())
  vendorId  String
  userId    String   @unique // In Week 2, one user belongs to one vendor company
  createdAt DateTime @default(now())

  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Rfq {
  id                  String          @id @default(uuid())
  code                String          @unique // e.g. RFQ-2026-0001
  title               String
  category            String
  description         String?
  deadline            DateTime
  status              RfqStatus       @default(DRAFT)
  version             Int             @default(1) // Optimistic locking
  publishedAt         DateTime?
  closedAt            DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  selectedQuotationId String?         @unique
  selectedById        String?
  selectedAt          DateTime?
  createdById         String
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  createdBy           User            @relation("RfqCreator", fields: [createdById], references: [id])
  selectedBy          User?           @relation("RfqSelector", fields: [selectedById], references: [id])
  items            RfqItem[]
  vendors          RfqVendor[]
  attachments      RfqAttachment[]
  quotations       Quotation[]       @relation("RfqQuotations")
  approvalRequests ApprovalRequest[]
  purchaseOrders   PurchaseOrder[]

  @@index([status, deadline])
  @@index([createdById, status])
  @@index([category])
  @@index([deletedAt])
}

model RfqItem {
  id          String          @id @default(uuid())
  rfqId       String
  position    Int
  name        String
  description String?
  quantity    Decimal         @db.Decimal(12, 2)
  unit        String
  rfq         Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotedItems QuotationItem[]

  @@unique([rfqId, position])
  @@index([rfqId])
}

model RfqVendor {
  rfqId     String
  vendorId  String
  invitedAt DateTime  @default(now())
  viewedAt  DateTime?
  rfq       Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([rfqId, vendorId])
  @@index([vendorId])
}

model RfqAttachment {
  id           String   @id @default(uuid())
  rfqId        String
  originalName String
  fileName     String
  fileSize     Int
  mimeType     String
  path         String
  createdAt    DateTime @default(now())
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model Quotation {
  id               String              @id @default(uuid())
  rfqId            String
  vendorId         String
  status           QuotationStatus     @default(DRAFT)
  version          Int                 @default(1)
  taxRate          Decimal             @db.Decimal(5, 2) @default(18.00)
  subtotal         Decimal             @db.Decimal(14, 2)
  taxAmount        Decimal             @db.Decimal(14, 2)
  grandTotal       Decimal             @db.Decimal(14, 2)
  deliveryDays     Int?
  paymentTermsDays Int?
  notes            String?
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  rfq              Rfq                 @relation("RfqQuotations", fields: [rfqId], references: [id], onDelete: Cascade)
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items            QuotationItem[]
  revisions        QuotationRevision[]
  approvalRequest  ApprovalRequest?
  purchaseOrder    PurchaseOrder?

  @@unique([rfqId, vendorId]) // BR-5: One quotation per (RFQ, Vendor)
  @@index([rfqId, status, grandTotal])
  @@index([vendorId])
}

model QuotationItem {
  id           String    @id @default(uuid())
  quotationId  String
  rfqItemId    String
  unitPrice    Decimal   @db.Decimal(14, 2)
  deliveryDays Int
  lineTotal    Decimal   @db.Decimal(14, 2)

  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem      RfqItem   @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([rfqItemId])
}

model QuotationRevision {
  id          String    @id @default(uuid())
  quotationId String
  revision    Int
  snapshot    Json
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, revision])
}

// Write-once forensic audit log table.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String   // e.g. AUTH_LOGIN, VENDOR_CREATED, RFQ_CREATED, QUOTATION_SUBMITTED
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String    // e.g. RFQ_PUBLISHED, QUOTATION_SUBMITTED, APPROVAL_REQUIRED, APPROVAL_DECIDED, PO_GENERATED, INVOICE_GENERATED, INVOICE_PAID, SYSTEM
  entityType String?   // RFQ, QUOTATION, APPROVAL, PURCHASE_ORDER, INVOICE
  entityId   String?
  link       String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  rfqId         String
  quotationId   String         @unique
  requestedById String
  decidedById   String?
  status        ApprovalStatus @default(PENDING)
  currentStep   Int            @default(2) // 1: Submitted, 2: L1 Review, 3: L2 Approval, 4: Generate PO
  remarks       String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  rfq         Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  timeline    ApprovalStep[]

  @@index([rfqId])
  @@index([status])
  @@index([requestedById])
  @@index([decidedById])
}

model ApprovalStep {
  id                String    @id @default(uuid())
  approvalRequestId String
  stepNumber        Int
  stepName          String    // e.g. "Submitted", "L1 Review", "L2 approval", "Generate PO"
  approverName      String    // e.g. "Rahul Mehta (Procurement head)", "Priya Shah (Finance manager)"
  approverRole      String    // e.g. "Procurement Head", "Finance Manager"
  status            String    // "APPROVED", "AWAITING", "PENDING", "REJECTED"
  remarks           String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  poNumber     String    @unique // PO-YYYY-NNNN
  rfqId        String
  quotationId  String    @unique
  vendorId     String
  createdById  String
  status       PoStatus  @default(ISSUED)
  poDate       DateTime  @default(now())
  deliveryDate DateTime?
  paymentTerms String?   @default("30 days net")
  notes        String?

  buyerName    String @default("Your Organization Name")
  buyerAddress String @default("123 Business Park, Ahmedabad")
  buyerGstin   String @default("25383438AFB")

  subtotal   Decimal @db.Decimal(14, 2)
  taxRate    Decimal @db.Decimal(5, 2) @default(18.00)
  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  taxAmount  Decimal @db.Decimal(14, 2)
  grandTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfq       Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy User                @relation("PoCreator", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
  invoice   Invoice?

  @@index([rfqId])
  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  name            String
  description     String?
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String
  unitPrice       Decimal       @db.Decimal(14, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // INV-YYYY-NNNN
  purchaseOrderId String        @unique
  vendorId        String
  createdById     String
  status          InvoiceStatus @default(PENDING_PAYMENT)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?

  buyerName    String @default("Your Organization Name")
  buyerAddress String @default("123 Business Park, Ahmedabad")
  buyerGstin   String @default("25383438AFB")

  subtotal   Decimal @db.Decimal(14, 2)
  taxRate    Decimal @db.Decimal(5, 2) @default(18.00)
  cgstAmount Decimal @db.Decimal(14, 2)
  sgstAmount Decimal @db.Decimal(14, 2)
  taxAmount  Decimal @db.Decimal(14, 2)
  grandTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  items         InvoiceItem[]

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String
  name      String
  quantity  Decimal  @db.Decimal(12, 2)
  unit      String
  unitPrice Decimal  @db.Decimal(14, 2)
  lineTotal Decimal  @db.Decimal(14, 2)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
